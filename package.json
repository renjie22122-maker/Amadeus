{
  "name": "amadeus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch server/main.ts",
    "web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && node scripts/build-server.mjs && vite build",
    "start": "node build/server/main.js",
    "check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --import tsx --test tests/*.test.ts",
    "build:server": "node scripts/build-server.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "eval:preflight": "node evals/benchmark/preflight.mjs"
  },
  "dependencies": {
    "@fastify/multipart": "^9.2.0",
    "@fastify/static": "^8.3.0",
    "@google/model-viewer": "^4.3.1",
    "@huggingface/transformers": "3.8.1",
    "@modelcontextprotocol/sdk": "^1.20.0",
    "diff": "^9.0.0",
    "docx": "9.7.1",
    "exceljs": "^4.4.0",
    "fastify": "^5.6.0",
    "highlight.js": "^11.12.0",
    "hnswlib-node": "^3.0.0",
    "katex": "^0.18.9",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.10.0",
    "mermaid": "^12.1.0",
    "pdfjs-dist": "^5.4.0",
    "playwright": "1.63.0",
    "pptxgenjs": "4.0.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "11.0.0",
    "sharp": "^0.35.5",
    "tsx": "^4.20.0",
    "unified": "11.0.5",
    "yaml": "^2.8.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "description": "Local-first AI workspace with scoped knowledge, agent collaboration and controlled execution.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/renjie22122-maker/Amadeus.git"
